# ─── Required: MySQL ────────────────────────────────────────────────────────
# Profiles + leaderboard live in MySQL. Without these the API returns 503.
# Run db/schema.sql once against this database to provision the tables.
DB_HOST=localhost
DB_USER=king
DB_PASSWORD=changeme
DB_NAME=king_card_game

# ─── Server ─────────────────────────────────────────────────────────────────
# HTTP + WebSocket port.
PORT=3001

# Comma-separated list of allowed origins (HTTP + Socket.IO CORS).
# Use "*" only for local development. In production, lock this down to your
# real frontend origin(s), e.g. https://kingcards.com,https://www.kingcards.com
CORS_ORIGIN=*

# ─── Admin ──────────────────────────────────────────────────────────────────
# Passcode for the /admin sound-management page. Optional — defaults to 2282.
# This is a "keep the other players out of the sound board" latch, not an
# authentication system; it's the only thing guarding the upload form, so set
# something less guessable if the site is publicly reachable.
ADMIN_PASSCODE=2282
