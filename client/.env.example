# Base URL for the Node/Express API and Socket.IO server.
#
# Local dev: leave blank or omit — the client falls back to
#   http://localhost:3001 (or http://<page-hostname>:3001 if you load the
#   site from a phone on the same LAN).
#
# Production: set this to the public URL of your server, including the
# protocol (https://) so socket.io upgrades to WSS.
#   VITE_API_URL=https://api.kingcards.com
VITE_API_URL=
